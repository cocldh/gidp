# snapshot 스크립트용 직접 PG 연결 문자열 (Supabase Dashboard > Project Settings > Database > Connection string > URI)
# 주의: Pooler(6543) 가 아닌 direct(5432) 또는 Session pooler URI 를 사용. Transaction pooler 는 prepared statement 제약 있음.

# 원본 ISS Supabase (lyqsabfezsmapbzdnlko) — read-only 접근만 수행
ISS_LEGACY_DB_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# GIDP Supabase (crtsgykvmowpxqfqchgy) — service_role 또는 postgres 유저 (RLS 우회 필요)
GIDP_DB_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
